{% if d_big %}
  {% assign a_cls = "value--base lg:value--xlarge" %}
{% else %}
  {% assign a_cls = "value--xsmall lg:value--small" %}
{% endif %}

<div class="layout layout--col layout--center gap--small lg:gap--medium">
  <span class="title lg:title--xlarge text--center" data-clamp="3">{{ d_question }}</span>

  <span class="value {{ a_cls }} text--center">{{ a_txt }}</span>

  {% if d_show %}
    <span class="description lg:description--xlarge text--center" data-clamp="1" data-clamp-lg="2">{{ d_fact }}</span>
  {% endif %}

  <span class="label label--small lg:label--base">CAT: {{ d_category }}</span>
</div>

<div class="title_bar">
  <span class="title">Geo Loop</span>
  <span class="instance">{{ trmnl.plugin_settings.instance_name }}</span>
</div>