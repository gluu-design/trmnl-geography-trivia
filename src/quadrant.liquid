{% if d_big %}
  {% assign a_cls = "value--small lg:value--base" %}
{% else %}
  {% assign a_cls = "value--xxsmall lg:value--xsmall" %}
{% endif %}

<div class="layout layout--col layout--center gap--small lg:gap--medium">
  <span class="title title--small lg:title--base text--center" data-clamp="4" data-clamp-lg="5">{{ d_question }}</span>

  <span class="value {{ a_cls }} text--center">{{ a_txt }}</span>

  <span class="label label--small lg:label--base">CAT: {{ d_category }}</span>
</div>