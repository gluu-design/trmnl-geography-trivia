{% if d_big %}
  {% assign a_cls = "value--large lg:value--xxlarge" %}
{% else %}
  {% assign a_cls = "value--small lg:value--base" %}
{% endif %}

<div class="layout layout--col layout--center gap--medium lg:gap--large">
  <span class="title title--large lg:title--xxlarge text--center">{{ d_question }}</span>

  <span class="value {{ a_cls }} text--center">{{ a_txt }}</span>

  {% if d_show %}
    <span class="description description--large lg:description--xxlarge text--center" data-clamp="3">{{ d_fact }}</span>
  {% endif %}

  <span class="label lg:label--large">CAT: {{ d_category }}</span>
</div>

<div class="title_bar">
  <span class="title">Geo Loop</span>
  <span class="instance">{{ trmnl.plugin_settings.instance_name }}</span>
</div>