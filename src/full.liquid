{% assign d_question = question | default: data.question | default: payload.question | default: "Which country has the most natural lakes?" %}
{% assign d_category = stat_category | default: data.stat_category | default: payload.stat_category | default: "Landforms" %}
{% assign d_answer = answer | default: data.answer | default: payload.answer | default: "Canada" %}
{% assign d_fact = fun_fact | default: data.fun_fact | default: payload.fun_fact | default: "Canada holds over 60% of all natural lakes on Earth." %}
{% assign raw_show = show_answer | default: data.show_answer | default: payload.show_answer %}
{% if raw_show == true or raw_show == 'true' or raw_show == 'True' %}{% assign d_show = true %}{% else %}{% assign d_show = false %}{% endif %}

<div class="title_bar">
  <span class="title">Geo Loop</span>
  <span class="instance">{{ trmnl.plugin_settings.instance_name }}</span>
</div>

<div class="layout layout--col layout--center">
  <span class="title title--large lg:title--xlarge text--center">{{ d_question }}</span>
  
  <div class="gap--large"></div>
  
  <span class="value value--large lg:value--xlarge text--center">
    {% if d_show %} {{ d_answer }} {% else %} LOCKED {% endif %}
  </span>
  
  <div class="gap--medium"></div>
  
  {% if d_show %}
    <span class="title title--small text--gray text--center">{{ d_fact }}</span>
  {% endif %}
  
  <div class="gap--large"></div>
  
  <span class="title title--small text--gray text--uppercase tracking--widest text--center">CAT: {{ d_category }}</span>
</div>